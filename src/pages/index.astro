---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Events from '../components/Events.astro';
import Cepev from '../components/Cepev.astro';
import Pac from '../components/Pac.astro';
import Videos from '../components/Videos.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';

const reader = createReader(process.cwd(), keystaticConfig);

const slides = await reader.collections.heroSlides.all();
const events = await reader.collections.events.all();
const videos = await reader.collections.videos.all();
const cepev = await reader.singletons.cepev.read();
const pac = await reader.singletons.pac.read();
const footer = await reader.singletons.footer.read();

// Fallback logic to prevent errors if content files are empty or missing
const safeSlides = slides.length > 0 ? slides : [
  {
    entry: {
      title: "Conferencia Anual Vida Para Todos 2026",
      description: "Un encuentro transformador para conectar con tu propósito y fortalecer los lazos de nuestra comunidad. Únete a nosotros este 25 de julio.",
      backgroundImage: "/images/hero/conferencia-anual.jpg",
      ctaLink: "https://forms.gle/mockform1",
      ctaLabel: "Inscribirse en la Conferencia"
    }
  }
];

const safeEvents = events.length > 0 ? events : [];
const safeVideos = videos.length > 0 ? videos : [];
const safeCepev = cepev || {
  title: "CEPEV: Centro de Preparación para la Vida",
  description: "El Centro de Preparación para la Vida (CEPEV) es un espacio dedicado al crecimiento integral de la persona. A través de seminarios, mentoría personalizada y talleres prácticos, te equipamos con herramientas emocionales, espirituales y éticas para afrontar con éxito los desafíos cotidianos.",
  ctaLink: "https://forms.gle/mockformcepev",
  ctaLabel: "Quiero ser parte de CEPEV",
  rotations: [
    {
      type: "frase",
      content: "La educación no es preparación para la vida; la educación es la vida misma en su máxima expresión de amor y servicio.",
      author: "Instituto Vida Para Todos"
    }
  ],
  gallery: [
    "/images/cepev/cepev-bga-3.jpg",
    "/images/cepev/cepev-bga-img-3115.jpg",
    "/images/cepev/cepev-bga-4.jpg",
    "/images/cepev/cepev-bga-5.jpg"
  ]
};

const safePac = pac || {
  title: "PAC",
  description: "PAC. Uniendo esfuerzos para llevar un mensaje de esperanza y servicio.",
  ctaLink: "https://forms.gle/mockformpac",
  ctaLabel: "Saber Más",
  whatIsTitle: "¿Que es el PAC?",
  whatIsContent: "Es una labor misionera que combina servicio, formación y propósito.",
  whereTitle: "¿Donde estamos?",
  whereContent: "Actualmente desarrollamos esta labor en Bogotá.",
  howTitle: "¿Como puedo ser parte?",
  howContent: "Puedes ser parte registrándote para servir con propósito.",
  gallery: ["/images/pac/slide-1.jpg", "/images/pac/slide-2.jpg", "/images/pac/slide-3.jpg"]
};

const safeFooter = footer || {
  email: "contacto@vidaparatodos.org",
  phone: "+56 9 1234 5678",
  address: "Av. Las Flores 450, Providencia, Santiago de Chile",
  facebookUrl: "https://facebook.com/ivpt",
  instagramUrl: "https://instagram.com/ivpt",
  youtubeUrl: "https://www.youtube.com/@InstitutoVidaParaTodos"
};

const siteUrl = Astro.site ? Astro.site.href : Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL('/images/og-image.jpg', siteUrl).href;
const logoUrl = new URL('/logo_vida_para_todos.png', siteUrl).href;

const pageTitle = "Instituto Vida Para Todos | Colombia";
const pageDescription = "Sitio oficial del Instituto Vida Para Todos en Colombia. Conferencias bíblicas, formación en CEPEV Bucaramanga y PAC.";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#1E4B7A" />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="IVPT Colombia" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Instituto Vida Para Todos" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Instituto Vida Para Todos Colombia - Banner Oficial" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Instituto Vida Para Todos Colombia" />

    <!-- Schema.org JSON-LD for Google / Rich Search Results -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NGO",
      "name": "Instituto Vida Para Todos Colombia",
      "alternateName": "IVPT Colombia",
      "url": canonicalUrl,
      "logo": logoUrl,
      "description": pageDescription,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": safeFooter.address,
        "addressLocality": "Bogotá",
        "addressCountry": "CO"
      },
      "telephone": safeFooter.phoneOrar,
      "sameAs": [
        safeFooter.facebookUrl,
        safeFooter.instagramUrl,
        safeFooter.youtubeUrl
      ].filter(Boolean)
    })} />
  </head>
  <body class="bg-neutral-light text-neutral-dark min-h-screen flex flex-col justify-between">
    <Navbar />
    <main class="flex-grow">
      <Hero slides={safeSlides} />
      <Events events={safeEvents} />
      <Cepev cepev={safeCepev} />
      <Pac pac={safePac} />
      <Videos videos={safeVideos} />
    </main>
    <Footer footer={safeFooter} />
  </body>
</html>
