---
// Cepev.astro
interface Props {
  cepev: any;
}
const { cepev } = Astro.props;

const gallery = (cepev.gallery && cepev.gallery.length > 0) ? cepev.gallery : [
  "/images/cepev/cepev-bga-3.jpg",
  "/images/cepev/cepev-bga-img-3115.jpg",
  "/images/cepev/cepev-bga-4.jpg",
  "/images/cepev/cepev-bga-5.jpg",
  "/images/cepev/cepev-bga-img-3220.jpg",
  "/images/cepev/cepev-bga-6.jpg",
  "/images/cepev/cepev-bga-7.jpg",
  "/images/cepev/cepev-bga-8.jpg"
];

const photoCaptions = [
  "Jóvenes colportores compartiendo la Palabra en Santander",
  "Comunidad, hermandad y servicio en Bucaramanga",
  "Sembrando semillas de verdad y esperanza en cada hogar",
  "Crecimiento espiritual, carácter y trabajo en equipo",
  "Capacitación continua y formación para la vida",
  "Testimonios vivos de transformación y fe",
  "Misión en las calles y plazas de la ciudad",
  "Una experiencia inolvidable de entrega y propósito"
];
---

<section id="cepev" class="py-12 md:py-24 bg-brand-light/30 border-y border-brand-accent/50 overflow-visible relative">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-start">
    
    <!-- Left Column: Info & Interactive Quotes -->
    <div class="lg:col-span-6 flex flex-col items-start">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand/10 text-brand text-xs font-bold uppercase tracking-wider mb-3 md:mb-4">
        <span class="w-2 h-2 rounded-full bg-brand"></span>
        <span>Formación de Vida • Bucaramanga</span>
      </div>

      <h2 class="text-2xl sm:text-3xl md:text-5xl font-extrabold text-neutral-dark tracking-tight leading-tight mb-3 md:mb-5">
        {cepev.title}
      </h2>

      <p class="text-neutral-muted text-xs sm:text-sm md:text-base leading-relaxed mb-5 md:mb-6 max-w-[55ch]">
        {cepev.description}
      </p>

      <div class="mb-6 md:mb-8">
        <a 
          href={cepev.ctaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-brand text-white px-6 md:px-7 py-3 md:py-3.5 rounded-xl hover:bg-brand-hover transition-spring hover-lift-rotate text-xs uppercase tracking-wider font-bold shadow-md"
        >
          <span>{cepev.ctaLabel}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Interactive Rotations Card -->
      <div class="w-full bg-white border border-brand-accent/70 p-5 md:p-8 rounded-2xl md:rounded-3xl shadow-lg transition-spring relative">
        <!-- Tab navigation -->
        <div class="flex flex-wrap gap-1.5 md:gap-2 mb-4 md:mb-6 border-b border-brand-accent/30 pb-3 md:pb-4">
          {cepev.rotations.map((item: any, idx: number) => (
            <button 
              class={`cepev-tab-btn px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-wider transition-spring ${idx === 0 ? 'bg-brand text-white' : 'bg-brand-light text-brand hover:bg-brand/10'}`}
              data-index={idx}
            >
              {item.type === 'versiculo' ? 'Versículo' : item.type === 'frase' ? 'Frase' : item.type === 'grito' ? 'Grito' : 'Inmersión'}
            </button>
          ))}
        </div>

        <!-- Content blocks -->
        <div class="relative min-h-[90px] md:min-h-[110px] flex flex-col justify-between">
          {cepev.rotations.map((item: any, idx: number) => (
            <div 
              class={`cepev-rotation-block transition-all duration-500 flex flex-col justify-between ${idx === 0 ? 'block opacity-100 scale-100' : 'hidden opacity-0 scale-95'}`}
              data-index={idx}
            >
              <blockquote class="text-sm sm:text-base md:text-lg font-semibold italic text-brand leading-relaxed mb-3 md:mb-4">
                "{item.content}"
              </blockquote>
              {item.author && (
                <cite class="text-[11px] md:text-xs font-bold text-neutral-muted uppercase tracking-wider not-italic block">
                  — {item.author}
                </cite>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Visual Changing Gallery of CEPEV Bucaramanga -->
    <div class="lg:col-span-6 relative mt-4 lg:mt-0 w-full">
      
      <!-- Decorative Backdrop Geometry -->
      <div class="absolute inset-0 bg-brand/10 rounded-3xl -translate-x-2 translate-y-2 md:-translate-x-3 md:translate-y-3 z-0"></div>

      <!-- Main Showcase Card -->
      <div 
        id="cepev-gallery-container"
        class="relative h-[350px] sm:h-[420px] md:h-[530px] rounded-3xl overflow-hidden shadow-2xl border border-brand-accent/80 bg-neutral-dark z-10 group select-none transition-spring rotate-[0.5deg] hover:rotate-0"
      >
        <!-- Slides -->
        {gallery.map((imgUrl: string, idx: number) => (
          <div 
            class={`cepev-slide absolute inset-0 transition-all duration-1000 ease-in-out ${idx === 0 ? 'opacity-100 z-10 scale-100' : 'opacity-0 z-0 scale-105 pointer-events-none'}`}
            data-index={idx}
          >
            <img 
              src={imgUrl} 
              alt={`CEPEV Bucaramanga - Foto ${idx + 1}`} 
              class="w-full h-full object-cover select-none"
              draggable="false"
            />
            <!-- Gradient Overlay for Contrast -->
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-dark/85 via-neutral-dark/20 to-neutral-dark/30 pointer-events-none"></div>
          </div>
        ))}

        <!-- Top Badges -->
        <div class="absolute top-5 left-5 right-5 z-20 flex items-center justify-between pointer-events-none">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/95 backdrop-blur-md text-neutral-dark text-xs font-bold shadow-md">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>CEPEV Bucaramanga</span>
          </span>
          <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-neutral-dark/80 backdrop-blur-md text-white text-xs font-mono font-bold shadow-md">
            <span id="cepev-slide-num">01</span> / <span>{gallery.length < 10 ? `0${gallery.length}` : gallery.length}</span>
          </span>
        </div>

        <!-- Navigation Arrows (appear on hover or touch) -->
        <button 
          id="cepev-prev-btn" 
          class="absolute left-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-white/90 hover:bg-white text-brand backdrop-blur flex items-center justify-center shadow-lg transition-transform hover:scale-110 active:scale-95 opacity-80 group-hover:opacity-100 focus:outline-none"
          aria-label="Foto anterior"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button 
          id="cepev-next-btn" 
          class="absolute right-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-white/90 hover:bg-white text-brand backdrop-blur flex items-center justify-center shadow-lg transition-transform hover:scale-110 active:scale-95 opacity-80 group-hover:opacity-100 focus:outline-none"
          aria-label="Siguiente foto"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Bottom Caption & Dots Bar -->
        <div class="absolute bottom-5 left-5 right-5 z-20 flex flex-col gap-3">
          <!-- Active Caption -->
          <div class="bg-neutral-dark/70 backdrop-blur-md p-3.5 rounded-xl border border-white/10">
            <p id="cepev-caption-text" class="text-white text-xs sm:text-sm font-semibold leading-snug drop-shadow-sm transition-opacity duration-300">
              {photoCaptions[0]}
            </p>
            <span class="text-white/70 text-[10px] uppercase tracking-wider block mt-1">
              Llevando la palabra hasta los confines de la tierra
            </span>
          </div>

          <!-- Interactive Dots -->
          <div class="flex items-center justify-between">
            <div class="flex gap-1.5">
              {gallery.map((_: any, idx: number) => (
                <button 
                  class={`cepev-dot h-2 rounded-full transition-all duration-300 ${idx === 0 ? 'w-6 bg-white' : 'w-2 bg-white/40 hover:bg-white/70'}`}
                  data-index={idx}
                  aria-label={`Ver foto ${idx + 1}`}
                ></button>
              ))}
            </div>
            <span class="text-white/80 text-[10px] font-medium tracking-wide">Auto • 4s</span>
          </div>
        </div>
      </div>

      <!-- Floating Secondary Accent Card for Design Variance & Layered Depth -->
      <div class="absolute -bottom-4 -right-2 md:-bottom-5 md:-right-4 z-20 bg-white p-3 md:p-4 rounded-2xl shadow-xl border border-brand-accent/80 flex items-center gap-3 transition-spring hover:scale-105">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center text-brand font-bold text-base shadow-inner">
          📖
        </div>
        <div>
          <strong class="text-xs text-neutral-dark block font-bold leading-tight">Colportaje Dinámico</strong>
          <span class="text-[10px] text-neutral-muted">Llevando la palabra hasta los confines de la tierra</span>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Tabs for Quotes
  const tabs = document.querySelectorAll('.cepev-tab-btn');
  const blocks = document.querySelectorAll('.cepev-rotation-block');

  tabs.forEach(tab => {
    tab.addEventListener('click', (e: any) => {
      const targetIdx = parseInt(e.currentTarget.dataset.index);

      tabs.forEach((t, idx) => {
        if (idx === targetIdx) {
          t.classList.remove('bg-brand-light', 'text-brand');
          t.classList.add('bg-brand', 'text-white');
        } else {
          t.classList.remove('bg-brand', 'text-white');
          t.classList.add('bg-brand-light', 'text-brand');
        }
      });

      blocks.forEach((block: any, idx) => {
        if (idx === targetIdx) {
          block.classList.remove('hidden');
          setTimeout(() => {
            block.classList.remove('opacity-0', 'scale-95');
            block.classList.add('opacity-100', 'scale-100');
          }, 50);
        } else {
          block.classList.add('hidden', 'opacity-0', 'scale-95');
          block.classList.remove('opacity-100', 'scale-100');
        }
      });
    });
  });

  // Gallery Slider with Auto-rotation
  const captions = [
    "Jóvenes colportores compartiendo la Palabra en Santander",
    "Comunidad, hermandad y servicio en Bucaramanga",
    "Sembrando semillas de verdad y esperanza en cada hogar",
    "Crecimiento espiritual, carácter y trabajo en equipo",
    "Capacitación continua y formación para la vida",
    "Testimonios vivos de transformación y fe",
    "Misión en las calles y plazas de la ciudad",
    "Una experiencia inolvidable de entrega y propósito"
  ];

  const slides = document.querySelectorAll('.cepev-slide');
  const dots = document.querySelectorAll('.cepev-dot');
  const counter = document.getElementById('cepev-slide-num');
  const captionEl = document.getElementById('cepev-caption-text');
  const prevBtn = document.getElementById('cepev-prev-btn');
  const nextBtn = document.getElementById('cepev-next-btn');
  const container = document.getElementById('cepev-gallery-container');

  let currentSlide = 0;
  const totalSlides = slides.length;
  let autoplayTimer: any = null;

  function showSlide(index: number) {
    if (totalSlides === 0) return;
    currentSlide = (index + totalSlides) % totalSlides;

    slides.forEach((slide, idx) => {
      if (idx === currentSlide) {
        slide.classList.remove('opacity-0', 'z-0', 'scale-105', 'pointer-events-none');
        slide.classList.add('opacity-100', 'z-10', 'scale-100');
      } else {
        slide.classList.remove('opacity-100', 'z-10', 'scale-100');
        slide.classList.add('opacity-0', 'z-0', 'scale-105', 'pointer-events-none');
      }
    });

    dots.forEach((dot, idx) => {
      if (idx === currentSlide) {
        dot.classList.remove('w-2', 'bg-white/40');
        dot.classList.add('w-6', 'bg-white');
      } else {
        dot.classList.remove('w-6', 'bg-white');
        dot.classList.add('w-2', 'bg-white/40');
      }
    });

    if (counter) {
      counter.textContent = currentSlide + 1 < 10 ? `0${currentSlide + 1}` : `${currentSlide + 1}`;
    }

    if (captionEl) {
      captionEl.style.opacity = '0';
      setTimeout(() => {
        captionEl.textContent = captions[currentSlide % captions.length];
        captionEl.style.opacity = '1';
      }, 150);
    }
  }

  function nextSlide() {
    showSlide(currentSlide + 1);
  }

  function prevSlide() {
    showSlide(currentSlide - 1);
  }

  function startAutoplay() {
    stopAutoplay();
    autoplayTimer = setInterval(nextSlide, 4000);
  }

  function stopAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  }

  dots.forEach(dot => {
    dot.addEventListener('click', (e: any) => {
      const idx = parseInt(e.currentTarget.dataset.index);
      showSlide(idx);
      startAutoplay();
    });
  });

  prevBtn?.addEventListener('click', () => {
    prevSlide();
    startAutoplay();
  });

  nextBtn?.addEventListener('click', () => {
    nextSlide();
    startAutoplay();
  });

  container?.addEventListener('mouseenter', stopAutoplay);
  container?.addEventListener('mouseleave', startAutoplay);

  // Start auto cycle
  startAutoplay();
</script>
